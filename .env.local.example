# Salin file ini jadi .env.local untuk development lokal.
# Di Vercel, isi nilai yang sama lewat Settings > Environment Variables.

# Client ID OAuth Google (BUKAN rahasia, boleh terlihat di browser - makanya prefix NEXT_PUBLIC_)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# API key Gemini (RAHASIA - dipakai server-side saja, di /pages/api/extract-screenshot.js)
GEMINI_API_KEY=
